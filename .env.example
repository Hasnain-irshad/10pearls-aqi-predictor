# ============================================================
#  Pearls AQI Predictor — environment variables
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit the real .env (it is gitignored).
# ============================================================

# ---- Hopsworks (Feature Store + Model Registry) ----
# Get your API key from: https://app.hopsworks.ai  ->  Account Settings -> API Keys
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT=aqi_predictor

# ---- Location to forecast (Lahore, Pakistan) ----
CITY_NAME=Lahore
LATITUDE=31.5204
LONGITUDE=74.3587
TIMEZONE=Asia/Karachi

# ---- Data source ----
# Open-Meteo needs NO API key. These are optional fallbacks.
# OPENWEATHER_API_KEY=
# AQICN_TOKEN=

# ---- AI advisor (optional MCP/LLM chatbot; Module: advisor) ----
# Set this to enable the in-dashboard air-quality assistant.
# --- LLM advisor (optional) -------------------------------------------------
# The advisor works with whichever key is present; free tiers are preferred.
# Gemini  - free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# Groq    - free key at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# Claude  - paid
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
#
# Optional overrides:
# AQI_ADVISOR_PROVIDER=gemini      # gemini | groq | claude (default: first key found)
# AQI_ADVISOR_MODEL=gemini-2.0-flash

# ---- Alerts (optional, added in Module 8) ----
# ALERT_EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

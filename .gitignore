# ---- Secrets & environment ----
.env
.env.*
!.env.example
*.key
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- Data & models (regenerated by pipelines; never commit large artifacts) ----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models_local/*
!models_local/.gitkeep
*.csv
*.parquet
*.pkl
*.joblib
*.h5
*.keras

# ---- Tooling ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
*.log

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Project docs build ----
docs/report/*.aux
docs/report/*.out

# Reference / answer-key code (not part of the submission)
reference/

# ---- Deploy artifacts that MUST ship (railway up + git honor .gitignore) ----
# These are committed on purpose; negations must come last to win over the
# data/processed/*, models_local/*, and *.joblib patterns above.
!data/processed/predictions.json
!data/processed/evaluation.json
!data/processed/monitoring.json
!models_local/leaderboard.json
!models_local/aqi_model.joblib
!models_local/aqi_model_meta.json

# LaTeX build artefacts (the compiled Thesis/main.pdf IS committed)
*.aux
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
